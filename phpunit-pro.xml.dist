<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<!-- The add-on's own tests, which only exist in a checkout that has it. -->
		<testsuite name="sigil-2fa-pro">
			<directory prefix="test-" suffix=".php">./pro/tests/</directory>
		</testsuite>
	</testsuites>
</phpunit>
